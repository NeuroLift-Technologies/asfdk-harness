{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "asfdk-governance-agent",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "main": "src/server.ts",
  // Keep variables set in the dashboard (ACCESS_CLIENT_ID, ACCESS_*_URL) on deploy;
  // without this, wrangler deletes every plain-text var not listed under "vars".
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "37151fbc32b944e59da444aa6117edfe"
    },
    {
      "binding": "GOVERNANCE",
      "id": "37151fbc32b944e59da444aa6117edfe"
    },
    {
      // MCP OAuth clients, grants and tokens (@cloudflare/workers-oauth-provider).
      // Namespace "asfdk-governance-OAUTH", dedicated to OAuth.
      "binding": "OAUTH_KV",
      "id": "31fd8d52237849279b988e6aa2037652"
    }
  ],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AsfdkGovernanceAgent",
        "class_name": "AsfdkGovernanceAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AsfdkGovernanceAgent"]
    }
  ],
  "vars": {
    "ASFDK_VERSION": "ORG-DEV-OTOI-1.0.4",
    "GOVERNANCE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "ASFDK_GOVERNANCE_MODE": "lenient"
  }
}
